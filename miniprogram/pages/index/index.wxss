.wrap {
    padding-bottom: 40rpx;
}

/* 搜索 */
.search-bar {
    display: flex;
    align-items: center;
    background: #ffffff;
    padding: 16rpx 24rpx;
    border-bottom: 1rpx solid #eaecef;
}

.search-input {
    flex: 1;
    height: 68rpx;
    background: #f5f5f5;
    border-radius: 34rpx;
    padding: 0 28rpx;
    font-size: 26rpx;
}

.ph {
    color: #a0a7b3;
}

.clear {
    font-size: 24rpx;
    color: #707a8a;
    padding-left: 20rpx;
}

/* 分类 */
.cats {
    display: flex;
    background: #ffffff;
    border-bottom: 1rpx solid #eaecef;
}

.cat {
    flex: 1;
    text-align: center;
    padding: 22rpx 0;
    font-size: 28rpx;
    color: #707a8a;
}

.cat-on {
    color: #1a1a1a;
    font-weight: 600;
    box-shadow: inset 0 -4rpx 0 #f0b90b;
}

/* 列表 */
.list {
    background: #ffffff;
}

.item {
    display: flex;
    align-items: center;
    padding: 20rpx 24rpx;
    border-bottom: 1rpx solid #eaecef;
}

.item:active {
    background: #fafafa;
}

.star {
    width: 56rpx;
    font-size: 34rpx;
    color: #d4d8de;
    text-align: left;
}

.star-on {
    color: #f0b90b;
}

.item-main {
    flex: 1;
    min-width: 0;
}

.item-title {
    display: flex;
    align-items: center;
}

.sym {
    font-size: 30rpx;
    font-weight: 600;
}

.sub {
    display: block;
    font-size: 22rpx;
    color: #a0a7b3;
    margin-top: 4rpx;
}

.item-right {
    text-align: right;
    min-width: 180rpx;
}

.price {
    display: block;
    font-size: 28rpx;
}

.chg {
    display: block;
    font-size: 24rpx;
    margin-top: 4rpx;
}

/* 提示 */
.hint {
    font-size: 22rpx;
    color: #a0a7b3;
    padding: 16rpx 24rpx;
}

.error {
    margin: 20rpx 24rpx;
    padding: 24rpx;
    background: #fff5f5;
    color: #c0392b;
    font-size: 24rpx;
    line-height: 1.7;
    border-radius: 12rpx;
}

.empty-line {
    display: block;
    margin-top: 8rpx;
}

.foot {
    padding: 40rpx 24rpx 20rpx;
    text-align: center;
}

.foot-line {
    display: block;
    font-size: 20rpx;
    color: #c2c7d0;
    line-height: 1.8;
}
